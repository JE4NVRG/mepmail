{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MepMail Correio",
  "version": "0.3.0",
  "identifier": "dev.mepmail.correio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "'self' https://mepmail.dev"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mepmail"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2ODc4OTNCREJFMjZCMUYKUldRZmErTGJPNG1ITnEzUVppNjR3aVB2YUZ4ZkVMeVFIb2lNSUtOMThGUzRCOVpwL3FGQ2ZIWi8K",
      "endpoints": [
        "https://mepmail.dev/desktop/correio/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "MepMail",
    "copyright": "MepMail. AGPL-3.0.",
    "category": "Productivity",
    "shortDescription": "MepMail Correio",
    "longDescription": "Correio, the MepMail inbox for people and their agents, as a Windows app.",
    "homepage": "https://mepmail.dev/correio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
